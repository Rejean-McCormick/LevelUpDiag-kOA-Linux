{
  "schema": "levelupdiag.koali.manifest.v1",
  "suite_name": "LevelUpDiag-Koali",
  "version": "1.0.0",
  "repository_mode": "standalone-development-appendix",
  "config_file": "levelupdiag.config.local.json",
  "config_example_file": "levelupdiag.config.example.json",
  "control_dir_default": ".levelupdiag",
  "levels": [
    {
      "id": "N00",
      "name": "Control Panel",
      "file": "levels/N00_control_panel.pyw",
      "enabled": true,
      "required": false,
      "depends_on": [],
      "timeout_seconds": 60,
      "purpose": "Lightweight LevelUpDiag-Koali self-check and local control point."
    },
    {
      "id": "N01",
      "name": "Environment",
      "file": "levels/N01_environment.pyw",
      "enabled": true,
      "required": true,
      "depends_on": [],
      "timeout_seconds": 120,
      "purpose": "Verify Python, configured paths, and required tools."
    },
    {
      "id": "N02",
      "name": "Repository",
      "file": "levels/N02_repository.pyw",
      "enabled": true,
      "required": true,
      "depends_on": [
        "N01"
      ],
      "timeout_seconds": 120,
      "purpose": "Observe the kOA-Linux checkout and its state without modifying it."
    },
    {
      "id": "N03",
      "name": "Documentation",
      "file": "levels/N03_documentation.pyw",
      "enabled": true,
      "required": true,
      "depends_on": [
        "N01",
        "N02"
      ],
      "timeout_seconds": 300,
      "purpose": "Run the configured public documentation validation."
