        "N01",
        "N02"
      ],
      "timeout_seconds": 300,
      "purpose": "Run the public contracts validation."
    },
    {
      "id": "N05",
      "name": "Components",
      "file": "levels/N05_components.pyw",
      "enabled": true,
      "required": true,
      "depends_on": [
        "N01",
        "N02",
        "N04"
      ],
      "timeout_seconds": 600,
      "purpose": "Run the public component validations."
    },
    {
      "id": "N06",
      "name": "Integrations",
      "file": "levels/N06_integrations.pyw",
      "enabled": true,
      "required": false,
      "depends_on": [
        "N01",
        "N02",
        "N04"
      ],
      "timeout_seconds": 600,
      "purpose": "Run public integration validations when configured."
    },
    {
      "id": "N07",
      "name": "Profiles",
      "file": "levels/N07_profiles.pyw",
      "enabled": true,
      "required": false,
      "depends_on": [
        "N01",
        "N02",
        "N04"
      ],
      "timeout_seconds": 600,
      "purpose": "Run public profile validations when configured."
    },
    {
      "id": "N08",
      "name": "Security",
      "file": "levels/N08_security.pyw",
      "enabled": true,
      "required": false,
      "depends_on": [
        "N01",
        "N02",
        "N04",
        "N05"
      ],
      "timeout_seconds": 900,
      "purpose": "Run the configured public security validation."
    },
    {
      "id": "N09",
      "name": "Offline",
      "file": "levels/N09_offline.pyw",
      "enabled": true,
      "required": false,
      "depends_on": [
        "N01",
        "N02",
        "N04",
        "N05"
      ],
      "timeout_seconds": 900,
      "purpose": "Run the configured public offline validation."
    },
    {
      "id": "N10",
      "name": "System",
      "file": "levels/N10_system.pyw",
      "enabled": true,
      "required": false,
      "depends_on": [
        "N01",
        "N02",
        "N04",
        "N05"
      ],
      "timeout_seconds": 1200,
      "purpose": "Run the configured public system validation."
    },
    {
      "id": "N11",
      "name": "Delivery",
      "file": "levels/N11_delivery.pyw",
      "enabled": true,
      "required": false,
      "depends_on": [
        "N01"
      ],
      "timeout_seconds": 300,
      "purpose": "Verify that the appendix is absent from a delivery target."
    }
