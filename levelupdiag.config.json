{
  "schema": "levelupdiag.config.v2",
  "app_name": "kOA-Linux",
  "target_repo_root": "../koa-linux",
  "control_dir": ".levelupdiag",
  "execution": {
    "max_parallel": 1,
    "default_timeout_seconds": 120,
    "fail_fast": false,
    "capture_limit_kb": 256,
    "protect_tracked_files": false,
    "allow_target_mutation": false,
    "allow_network": false
  },
  "toolchain": {
    "required": [
      "python",
      "uv",
      "git",
      "cargo",
      "rustc",
      "cc"
    ],
    "optional": [
      "rustup"
    ]
  },
  "environment_sync_command": [
    "uv",
    "sync",
    "--frozen",
    "--all-groups"
  ],
  "commands": {
    "docs": [
      "uv",
      "run",
      "--frozen",
      "python",
      "docs/tools/validate_docs.py"
    ],
    "contracts": [
      "uv",
      "run",
      "--frozen",
      "python",
      "ci/scripts/run-contracts.py"
    ],
    "components": [
      "uv",
      "run",
      "--frozen",
      "python",
      "ci/scripts/run-components.py"
    ],
    "integrations": [],
    "security": [
      "uv",
      "run",
      "--frozen",
      "python",
      "ci/scripts/run-security.py"
    ],
    "offline": [
      "uv",
      "run",
      "--frozen",
      "python",
      "ci/scripts/run-offline.py"
    ],
    "system": [
      "uv",
      "run",
      "--frozen",
      "python",
      "ci/scripts/run-system-tests.py"
    ]
  },
  "profiles_command": [
    "uv",
    "run",
    "--frozen",
    "pytest",
    "-q",
    "tests/profiles"
  ],
  "delivery_target": "",
  "env": {
    "KOA_CI_EVIDENCE_DIR": ".levelupdiag/koa-ci-evidence"
  },
  "redaction": {
    "enabled": true,
    "replacement": "<REDACTED>"
  },
  "koa": {
    "gate_report_directory": "koa-ci-evidence",
    "gate_report_suffix": "-gate-report.json",
    "gate_report_capture_kb": 128
  },
  "default_mode": "debug",
  "modes": {
    "debug": {
      "protect_tracked_files": false,
      "dependency_blocking_verdicts": [],
      "campaign_policy": "diagnostic"
    },
    "validation": {
      "protect_tracked_files": false,
      "dependency_blocking_verdicts": [
        "BLOCKED",
        "ERROR",
        "INFRA_ERROR",
        "CONFIG_ERROR"
      ],
      "campaign_policy": "validation"
    },
    "release": {
      "protect_tracked_files": true,
      "dependency_blocking_verdicts": [
        "BLOCKED",
        "ERROR",
        "INFRA_ERROR",
        "CONFIG_ERROR"
      ],
      "campaign_policy": "release"
    }
  },
  "default_campaign": "koali-final",
  "qualification": {
    "default_scope": "koali_final_delta",
    "final_profile": "sovereign-linux-node",
    "deferred_subsystems": {}
  },
  "ui_modularity": {
    "enabled": false,
    "base_root": "..",
    "products": []
  },
  "desktop_console": {
    "execution_backend": "auto",
    "wsl_python_candidates": [
      "python3",
      "python"
    ],
    "wsl_path_prepend": [
      "~/.local/bin",
      "~/.cargo/bin"
    ],
    "campaign_backends": {
      "koali-system": "native",
      "koali-system-debug": "native",
      "N12": "native",
      "store": "native",
      "N13": "native",
      "koali-final": "native",
      "koali-final-debug": "native"
    },
    "wsl_distro": "Ubuntu-24.04",
    "wsl_target_root": "~/work/koa-linux"
  },
  "koali_system": {
    "enabled": true,
    "root": "../koali-spaces",
    "state_dir": ".koali-dev/state",
    "shell_url": "http://127.0.0.1:4173",
    "shell_state_endpoint": "/api/shell-state",
    "max_state_age_seconds": 30,
    "probe_timeout_seconds": 3,
    "live_http": true,
    "expected_network_state": "online",
    "launcher_markers": [
      "START_KOALI.cmd",
      "CHECK_KOALI.cmd",
      "STOP_KOALI.cmd",
      "KOALI.pyw"
    ],
    "expected_products": [
      {
        "id": "orgo",
        "module_id": "orgo",
        "shell_critical": true,
        "allow_unready": false,
        "presentation": true
      },
      {
        "id": "orgo_worlds",
        "module_id": "orgo_worlds",
        "shell_critical": true,
        "allow_unready": false,
        "presentation": true
      },
      {
        "id": "semantik_architect",
        "module_id": "semantik_architect",
        "shell_critical": false,
        "allow_unready": false,
        "presentation": false
      },
      {
        "id": "koa_mediatheque",
        "module_id": "koa_mediatheque",
        "shell_critical": true,
        "allow_unready": false,
        "presentation": true
      },
      {
        "id": "konfid",
        "module_id": "konfid",
        "shell_critical": false,
        "allow_unready": false,
        "presentation": false
      },
      {
        "id": "kor",
        "module_id": "kor",
        "shell_critical": false,
        "allow_unready": false,
        "presentation": false
      }
    ],
    "expected_sources": [
      {
        "id": "koa_mediatheque_blank_instance",
        "required": true,
        "reference_only": false,
        "qualification_state": "ready"
      },
      {
        "id": "koa_linux",
        "required": true,
        "reference_only": false,
        "qualification_state": "ready"
      },
      {
        "id": "koali_control_panel",
        "required": true,
        "reference_only": false,
        "qualification_state": "ready"
      },
      {
        "id": "koa_digital_ecosystem",
        "required": true,
        "reference_only": false,
        "qualification_state": "ready"
      },
      {
        "id": "interaction_kernel",
        "required": true,
        "reference_only": false,
        "qualification_state": "ready"
      },
      {
        "id": "semantik_runtime_orchestrator",
        "required": true,
        "reference_only": false,
        "qualification_state": "ready"
      },
      {
        "id": "kristal_framework",
        "required": false,
        "reference_only": true,
        "qualification_state": "reference"
      }
    ]
  },
  "campaign_targets": {
    "koali-system": "../koali-spaces",
    "koali-system-debug": "../koali-spaces",
    "store": "../koa-linux",
    "koali-final": "../koali-spaces",
    "koali-final-debug": "../koali-spaces"
  },
  "store": {
    "root": "../koa-linux",
    "runtime_checks": false
  },
  "koali_final": {
    "enabled": true,
    "catalog": "config/ecosystem.catalog.json",
    "bootstrap_script": "scripts/bootstrap-koali.ps1",
    "bootstrap_status": ".koali-dev/bootstrap/bootstrap-status.json",
    "launcher_markers": [
      "START_KOALI.cmd",
      "CHECK_KOALI.cmd",
      "STOP_KOALI.cmd",
      "KOALI.pyw"
    ],
    "required_products": {
      "orgo": {
        "affects_shell_state": true
      },
      "orgo_worlds": {
        "affects_shell_state": true
      },
      "semantik_architect": {
        "affects_shell_state": false
      },
      "koa_mediatheque": {
        "affects_shell_state": true
      },
      "konfid": {
        "affects_shell_state": false
      },
      "kor": {
        "affects_shell_state": false
      }
    },
    "required_sources": [
      "koa_mediatheque_blank_instance",
      "koa_linux",
      "koali_control_panel",
      "koa_digital_ecosystem",
      "interaction_kernel",
      "semantik_runtime_orchestrator"
    ],
    "owner_contracts": {
      "orgo": {
        "path": "Orgo/Orgo/koali.integration.json",
        "surface": "web"
      },
      "orgo_worlds": {
        "path": "Orgo/Orgo_Worlds/koali.integration.json",
        "surface": "web"
      },
      "semantik_architect": {
        "path": "SemantiK_Architect/SemantiK_Architect/koali.integration.json",
        "surface": "headless"
      },
      "koa_mediatheque": {
        "path": "kOA_Mediatheque/mediatheque/koali.integration.json",
        "surface": "web"
      },
      "konfid": {
        "path": "Konfid/konfid/koali.integration.json",
        "surface": "headless"
      },
      "kor": {
        "path": "Kor/kor/koali.integration.json",
        "surface": "headless"
      }
    },
    "bootstrap_contract_tokens": [
      "uv.exe' @('python','install','3.12','3.13','3.14')",
      "Ensure-PythonProject 'kor'",
      "'3.14'",
      "Ensure-PythonProject 'koa-mediatheque'",
      "Ensure-NodeProject 'interaction-kernel-typescript'",
      "Ensure-PythonProject 'interaction-kernel'",
      "koa-mediatheque-instance",
      "Docker is not required for Koali local start"
    ],
    "required_bootstrap_events": [
      "node",
      "pnpm",
      "uv",
      "python-runtimes",
      "koali-spaces",
      "orgo",
      "orgo-worlds",
      "interaction-kernel-typescript",
      "semantik-architect",
      "semantik-runtime-orchestrator",
      "konfid",
      "kor",
      "interaction-kernel",
      "koa-mediatheque",
      "koa-linux",
      "koa-mediatheque-instance",
      "koali-control-panel",
      "orgo-local-database"
    ],
    "mediatheque": {
      "engine": "kOA_Mediatheque/mediatheque",
      "instance": "kOA_Mediatheque/mediatheque-blank",
      "config": "mediatheque.instance.toml",
      "database": "01_DB/koa_mediatheque.sqlite"
    },
    "expected_reserved_ports": [
      3100,
      4100,
      4173,
      4302,
      4303,
      8301,
      8304,
      8305,
      8501,
      55432
    ]
  }
}
