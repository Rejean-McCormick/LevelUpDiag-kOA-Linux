{
  "schema": "levelupdiag.config.v2",
  "app_name": "kOA-Linux",
  "target_repo_root": "../koa-linux",
  "control_dir": ".levelupdiag",
  "execution": {
    "max_parallel": 1,
    "default_timeout_seconds": 120,
    "fail_fast": false,
    "capture_limit_kb": 256,
    "protect_tracked_files": false,
    "allow_target_mutation": false,
    "allow_network": false
  },
  "toolchain": {
    "required": [
      "python",
      "uv",
      "git",
      "cargo",
      "rustc",
      "cc"
    ],
    "optional": [
      "rustup"
    ]
  },
  "environment_sync_command": [
    "uv",
    "sync",
    "--frozen",
    "--all-groups"
  ],
  "commands": {
    "docs": [
      "uv",
      "run",
      "--frozen",
      "python",
      "docs/tools/validate_docs.py"
    ],
    "contracts": [
      "uv",
      "run",
      "--frozen",
      "python",
      "ci/scripts/run-contracts.py"
    ],
    "components": [
      "uv",
      "run",
      "--frozen",
      "python",
      "ci/scripts/run-components.py"
    ],
    "integrations": [],
    "security": [
      "uv",
      "run",
      "--frozen",
      "python",
      "ci/scripts/run-security.py"
    ],
    "offline": [
      "uv",
      "run",
      "--frozen",
      "python",
      "ci/scripts/run-offline.py"
    ],
    "system": [
      "uv",
      "run",
      "--frozen",
      "python",
      "ci/scripts/run-system-tests.py"
    ]
  },
  "profiles_command": [
    "uv",
    "run",
    "--frozen",
    "pytest",
    "-q",
    "tests/profiles"
  ],
  "delivery_target": "",
  "env": {
    "KOA_CI_EVIDENCE_DIR": ".levelupdiag/koa-ci-evidence"
  },
  "redaction": {
    "enabled": true,
    "replacement": "<REDACTED>"
  },
  "koa": {
    "gate_report_directory": "koa-ci-evidence",
    "gate_report_suffix": "-gate-report.json",
    "gate_report_capture_kb": 128
  },
  "default_mode": "debug",
  "modes": {
    "debug": {
      "protect_tracked_files": false,
      "dependency_blocking_verdicts": [],
      "campaign_policy": "diagnostic"
    },
    "validation": {
      "protect_tracked_files": false,
      "dependency_blocking_verdicts": [
        "BLOCKED",
        "ERROR",
        "INFRA_ERROR",
        "CONFIG_ERROR"
      ],
      "campaign_policy": "validation"
    },
    "release": {
      "protect_tracked_files": true,
      "dependency_blocking_verdicts": [
        "BLOCKED",
        "ERROR",
        "INFRA_ERROR",
        "CONFIG_ERROR"
      ],
      "campaign_policy": "release"
    }
  },
  "default_campaign": "koali-system",
  "qualification": {
    "default_scope": "koali_product_system",
    "final_profile": "sovereign-linux-node",
    "deferred_subsystems": {
      "konnaxion": "placeholder_until_integration",
      "ariane": "deferred_until_koali_integration_test",
      "orgo": "draft_not_admitted",
      "semantik_architect": "deferred_not_admitted"
    }
  },
  "ui_modularity": {
    "enabled": false,
    "base_root": "..",
    "products": []
  },
  "desktop_console": {
    "execution_backend": "auto",
    "wsl_python_candidates": [
      "python3",
      "python"
    ],
    "wsl_path_prepend": [
      "~/.local/bin",
      "~/.cargo/bin"
    ],
    "campaign_backends": {
      "koali-system": "native",
      "koali-system-debug": "native",
      "N12": "native",
      "store": "native",
      "N13": "native"
    },
    "wsl_distro": "Ubuntu-24.04",
    "wsl_target_root": "~/work/koa-linux"
  },
  "koali_system": {
    "enabled": true,
    "root": "../koali-spaces",
    "state_dir": ".koali-dev/state",
    "shell_url": "http://127.0.0.1:4173",
    "shell_state_endpoint": "/api/shell-state",
    "max_state_age_seconds": 30,
    "probe_timeout_seconds": 3,
    "live_http": true,
    "expected_network_state": "online",
    "launcher_markers": [
      "RUN_KOALI.cmd",
      "KOALI.pyw"
    ],
    "expected_products": [
      {
        "id": "konnaxion",
        "module_id": "konnaxion",
        "shell_critical": true,
        "allow_unready": false
      },
      {
        "id": "orgo",
        "module_id": "orgo",
        "shell_critical": true,
        "allow_unready": false
      },
      {
        "id": "semantik_architect",
        "module_id": "semantik_architect",
        "shell_critical": false,
        "allow_unready": true
      },
      {
        "id": "koa_mediatheque",
        "module_id": "koa_mediatheque",
        "shell_critical": true,
        "allow_unready": false
      }
    ],
    "expected_sources": [
      "kristal_framework",
      "koa_linux",
      "koali_control_panel",
      "koa_digital_ecosystem"
    ]
  },
  "campaign_targets": {
    "koali-system": "../koali-spaces",
    "koali-system-debug": "../koali-spaces",
    "store": "../koa-linux"
  },
  "store": {
    "root": "../koa-linux",
    "runtime_checks": false
  }
}
