{
  "schema": "levelupdiag.config.v2",
  "default_mode": "debug",
  "delivery_target": "",
  "commands": {
    "integrations": []
  },
  "env": {
    "KOA_CI_EVIDENCE_DIR": ".levelupdiag/koa-ci-evidence"
  },
  "ui_modularity": {
    "enabled": false,
    "base_root": "..",
    "products": []
  },
  "desktop_console": {
    "execution_backend": "auto",
    "wsl_python_candidates": [
      "python3",
      "python"
    ],
    "wsl_path_prepend": [
      "~/.local/bin",
      "~/.cargo/bin"
    ]
  }
}
